<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <android.opengl.GLSurfaceView
        android:id="@+id/glView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:fitsSystemWindows="true"
        android:padding="8dp">

        <Button android:id="@+id/backButton" style="@style/Btn" android:text="@string/back" />
        <Button android:id="@+id/motionButton" style="@style/Btn" android:text="@string/motion_off" />
        <Button android:id="@+id/shareButton" style="@style/Btn.Primary" android:text="@string/share" />
    </LinearLayout>
</FrameLayout>
